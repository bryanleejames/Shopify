# ── FluxPay Backend — environment configuration ─────────────────────────────
# Copy to .env and fill in values. NEVER commit the real .env file.

# Server
NODE_ENV=development            # set to "production" on hosted deployments
PORT=3001
HOST=0.0.0.0
# SQLite database file. Use a persistent mounted path in containers,
# e.g. /app/data/fluxpay.db with a volume on /app/data.
DATABASE_PATH=./fluxpay.db
# Comma-separated CORS allow-list (e.g. https://app.fluxpay.io).
# Empty/absent = allow all origins (dev default).
CORS_ORIGINS=
# "true" to keep /dev/* endpoints on in production (default: off)
ENABLE_DEV_ENDPOINTS=
# "true" when running behind a reverse proxy that terminates TLS
TRUST_PROXY=

# Auth — REQUIRED in production: a long, random string
JWT_SECRET=change-me-to-a-long-random-string

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Push notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# Email (SMTP) — optional; falls back to console logging when unset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FluxPay <noreply@fluxpay.app>

# Admin / misc
ADMIN_API_KEY=
API_URL=http://localhost:3001